{
  "name": "shiguang-media-tools",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "uv run --no-sync python start.py",
    "stop": "uv run --no-sync python start.py stop",
    "status": "uv run --no-sync python start.py status",
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "test:web": "playwright test",
    "render": "tsx apps/renderer/render.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/player": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/transitions": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
