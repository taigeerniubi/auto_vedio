# start.py 自动加载根目录 .env，已设置的系统环境变量优先。
# 支持 openai 或 deepseek，一次运行使用一种服务。
SHIGUANG_MODEL_PROVIDER=deepseek
# 填写你在服务商控制台中可用、支持工具调用的模型名。
SHIGUANG_MODEL_NAME=
SHIGUANG_MODEL_API_KEY=
# 留空时使用官方地址；OpenAI 自定义地址须包含 /v1。
SHIGUANG_MODEL_BASE_URL=
# 每轮输出预算（含服务商计入的推理 token），允许 1024–65536；默认 16384。
SHIGUANG_MODEL_MAX_OUTPUT_TOKENS=16384

# 视觉与语音独立配置，不继承剪辑 Agent 的密钥或模型。
# 视觉：Chat Completions + image_url + JSON object；填写支持图片的模型。
SHIGUANG_VISION_BASE_URL=https://api.openai.com/v1
SHIGUANG_VISION_MODEL=
SHIGUANG_VISION_API_KEY=
# 语音：/audio/transcriptions；字幕要求 segments 句级时间戳。
SHIGUANG_SPEECH_BASE_URL=https://api.openai.com/v1
SHIGUANG_SPEECH_MODEL=
SHIGUANG_SPEECH_API_KEY=
# verbose_json 用于带时间戳字幕；仅支持 json 的接口可用于口述输入。
SHIGUANG_SPEECH_RESPONSE_FORMAT=verbose_json

# 按问题听取音频或视频原声；默认使用百炼北京兼容端点，可按业务空间调整。
SHIGUANG_AUDIO_API_KEY=
SHIGUANG_AUDIO_MODEL=qwen3.8-omni-flash
SHIGUANG_AUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
