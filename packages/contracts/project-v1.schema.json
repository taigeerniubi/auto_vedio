{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "timeline",
          "enum": [
            "timeline",
            "clip"
          ],
          "title": "Kind",
          "type": "string"
        },
        "clip_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Id"
        },
        "start_frame": {
          "default": 0,
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        }
      },
      "required": [
        "end_frame"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "AudioItem": {
      "additionalProperties": false,
      "properties": {
        "audio_id": {
          "title": "Audio Id",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "source_in_frame": {
          "default": 0,
          "minimum": 0,
          "title": "Source In Frame",
          "type": "integer"
        },
        "track": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Track",
          "type": "integer"
        },
        "gain_db": {
          "default": -12,
          "maximum": 12,
          "minimum": -60,
          "title": "Gain Db",
          "type": "number"
        },
        "fade_in_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Fade In Frames",
          "type": "integer"
        },
        "fade_out_frames": {
          "default": 0,
          "minimum": 0,
          "title": "Fade Out Frames",
          "type": "integer"
        },
        "ducks": {
          "items": {
            "$ref": "#/$defs/Duck"
          },
          "title": "Ducks",
          "type": "array"
        }
      },
      "required": [
        "audio_id",
        "asset_id",
        "anchor"
      ],
      "title": "AudioItem",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$",
          "title": "Clip Id",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "image"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_in_frame": {
          "default": 0,
          "minimum": 0,
          "title": "Source In Frame",
          "type": "integer"
        },
        "source_out_frame": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Out Frame"
        },
        "still_duration_frames": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Still Duration Frames"
        },
        "rate_num": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Rate Num",
          "type": "integer"
        },
        "rate_den": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Rate Den",
          "type": "integer"
        },
        "reverse": {
          "default": false,
          "title": "Reverse",
          "type": "boolean"
        },
        "original_audio_gain_db": {
          "default": 0,
          "maximum": 12,
          "minimum": -60,
          "title": "Original Audio Gain Db",
          "type": "number"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Motion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "color_preset": {
          "anyOf": [
            {
              "enum": [
                "natural",
                "cream",
                "warm",
                "portrait",
                "soft_skin",
                "cool_portrait",
                "forest",
                "ocean",
                "autumn",
                "food",
                "coffee",
                "fresh",
                "teal_orange",
                "faded_film",
                "vintage",
                "cool",
                "neon",
                "monochrome"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Preset"
        },
        "color_preset_intensity": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Color Preset Intensity",
          "type": "number"
        },
        "color_grade": {
          "$ref": "#/$defs/ColorGrade"
        },
        "derived_from_clip_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From Clip Id"
        }
      },
      "required": [
        "clip_id",
        "asset_id",
        "kind"
      ],
      "title": "Clip",
      "type": "object"
    },
    "ColorCurves": {
      "additionalProperties": false,
      "properties": {
        "master": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Master",
          "type": "array"
        },
        "red": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Red",
          "type": "array"
        },
        "green": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Green",
          "type": "array"
        },
        "blue": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Blue",
          "type": "array"
        },
        "hue_hue": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Hue Hue",
          "type": "array"
        },
        "hue_sat": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Hue Sat",
          "type": "array"
        },
        "hue_lum": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Hue Lum",
          "type": "array"
        }
      },
      "title": "ColorCurves",
      "type": "object"
    },
    "ColorGrade": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "exposure": {
          "default": 0,
          "maximum": 5,
          "minimum": -5,
          "title": "Exposure",
          "type": "number"
        },
        "contrast": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Contrast",
          "type": "number"
        },
        "temperature": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Temperature",
          "type": "number"
        },
        "tint": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Tint",
          "type": "number"
        },
        "saturation": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Saturation",
          "type": "number"
        },
        "vibrance": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Vibrance",
          "type": "number"
        },
        "highlights": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Highlights",
          "type": "number"
        },
        "shadows": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Shadows",
          "type": "number"
        },
        "whites": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Whites",
          "type": "number"
        },
        "blacks": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Blacks",
          "type": "number"
        },
        "wheels": {
          "$ref": "#/$defs/ColorWheels"
        },
        "hsl": {
          "$ref": "#/$defs/HslChannels"
        },
        "curves": {
          "$ref": "#/$defs/ColorCurves"
        }
      },
      "title": "ColorGrade",
      "type": "object"
    },
    "ColorWheel": {
      "additionalProperties": false,
      "properties": {
        "hue": {
          "default": 0,
          "maximum": 360,
          "minimum": 0,
          "title": "Hue",
          "type": "number"
        },
        "saturation": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Saturation",
          "type": "number"
        },
        "luminance": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Luminance",
          "type": "number"
        }
      },
      "title": "ColorWheel",
      "type": "object"
    },
    "ColorWheels": {
      "additionalProperties": false,
      "properties": {
        "shadows": {
          "$ref": "#/$defs/ColorWheel"
        },
        "midtones": {
          "$ref": "#/$defs/ColorWheel"
        },
        "highlights": {
          "$ref": "#/$defs/ColorWheel"
        },
        "offset": {
          "$ref": "#/$defs/ColorWheel"
        }
      },
      "title": "ColorWheels",
      "type": "object"
    },
    "Composition": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "default": 1920,
          "maximum": 1920,
          "minimum": 64,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "maximum": 1920,
          "minimum": 64,
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "const": 30,
          "default": 30,
          "title": "Fps",
          "type": "integer"
        },
        "audio_sample_rate": {
          "const": 48000,
          "default": 48000,
          "title": "Audio Sample Rate",
          "type": "integer"
        },
        "color_space": {
          "const": "sdr_bt709",
          "default": "sdr_bt709",
          "title": "Color Space",
          "type": "string"
        }
      },
      "title": "Composition",
      "type": "object"
    },
    "Cover": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "default": "timeline",
          "enum": [
            "timeline",
            "image"
          ],
          "title": "Source",
          "type": "string"
        },
        "frame": {
          "default": 0,
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "title": {
          "default": "",
          "maxLength": 120,
          "title": "Title",
          "type": "string"
        },
        "x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.75,
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "font_size": {
          "default": 72,
          "maximum": 240,
          "minimum": 12,
          "title": "Font Size",
          "type": "number"
        },
        "color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "shade": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Shade",
          "type": "number"
        },
        "fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Fit",
          "type": "string"
        }
      },
      "title": "Cover",
      "type": "object"
    },
    "CurvePoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CurvePoint",
      "type": "object"
    },
    "Duck": {
      "additionalProperties": false,
      "properties": {
        "clip_id": {
          "title": "Clip Id",
          "type": "string"
        },
        "gain_db": {
          "default": -12,
          "maximum": 0,
          "minimum": -60,
          "title": "Gain Db",
          "type": "number"
        },
        "ramp_frames": {
          "default": 6,
          "minimum": 0,
          "title": "Ramp Frames",
          "type": "integer"
        }
      },
      "required": [
        "clip_id"
      ],
      "title": "Duck",
      "type": "object"
    },
    "HslChannel": {
      "additionalProperties": false,
      "properties": {
        "hue": {
          "default": 0,
          "maximum": 180,
          "minimum": -180,
          "title": "Hue",
          "type": "number"
        },
        "saturation": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Saturation",
          "type": "number"
        },
        "luminance": {
          "default": 0,
          "maximum": 1,
          "minimum": -1,
          "title": "Luminance",
          "type": "number"
        }
      },
      "title": "HslChannel",
      "type": "object"
    },
    "HslChannels": {
      "additionalProperties": false,
      "properties": {
        "red": {
          "$ref": "#/$defs/HslChannel"
        },
        "orange": {
          "$ref": "#/$defs/HslChannel"
        },
        "yellow": {
          "$ref": "#/$defs/HslChannel"
        },
        "green": {
          "$ref": "#/$defs/HslChannel"
        },
        "cyan": {
          "$ref": "#/$defs/HslChannel"
        },
        "blue": {
          "$ref": "#/$defs/HslChannel"
        },
        "purple": {
          "$ref": "#/$defs/HslChannel"
        },
        "magenta": {
          "$ref": "#/$defs/HslChannel"
        }
      },
      "title": "HslChannels",
      "type": "object"
    },
    "Motion": {
      "additionalProperties": false,
      "properties": {
        "preset_id": {
          "enum": [
            "slow_push_in",
            "slow_pull_out",
            "pan_left",
            "pan_right",
            "pan_up",
            "pan_down"
          ],
          "title": "Preset Id",
          "type": "string"
        },
        "preset_version": {
          "const": 1,
          "default": 1,
          "title": "Preset Version",
          "type": "integer"
        },
        "local_start_frame": {
          "default": 0,
          "minimum": 0,
          "title": "Local Start Frame",
          "type": "integer"
        },
        "local_end_frame": {
          "exclusiveMinimum": 0,
          "title": "Local End Frame",
          "type": "integer"
        },
        "anchor_x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor Y",
          "type": "number"
        },
        "intensity": {
          "default": 0.12,
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Intensity",
          "type": "number"
        },
        "easing": {
          "default": "ease_in_out",
          "enum": [
            "linear",
            "ease_in_out"
          ],
          "title": "Easing",
          "type": "string"
        }
      },
      "required": [
        "preset_id",
        "local_end_frame"
      ],
      "title": "Motion",
      "type": "object"
    },
    "TextItem": {
      "additionalProperties": false,
      "properties": {
        "text_id": {
          "title": "Text Id",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/Anchor"
        },
        "style_preset": {
          "default": "title",
          "enum": [
            "title",
            "subtitle"
          ],
          "title": "Style Preset",
          "type": "string"
        },
        "x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "font_size": {
          "default": 48,
          "maximum": 200,
          "minimum": 8,
          "title": "Font Size",
          "type": "number"
        },
        "color": {
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "text_id",
        "text",
        "anchor"
      ],
      "title": "TextItem",
      "type": "object"
    },
    "Transform": {
      "additionalProperties": false,
      "properties": {
        "fit": {
          "default": "cover",
          "enum": [
            "cover",
            "contain"
          ],
          "title": "Fit",
          "type": "string"
        },
        "anchor_x": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor X",
          "type": "number"
        },
        "anchor_y": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Anchor Y",
          "type": "number"
        },
        "scale": {
          "default": 1,
          "maximum": 4,
          "minimum": 0.1,
          "title": "Scale",
          "type": "number"
        },
        "scale_x": {
          "default": 1,
          "maximum": 4,
          "minimum": 0.1,
          "title": "Scale X",
          "type": "number"
        },
        "scale_y": {
          "default": 1,
          "maximum": 4,
          "minimum": 0.1,
          "title": "Scale Y",
          "type": "number"
        },
        "rotation_deg": {
          "default": 0,
          "maximum": 15,
          "minimum": -15,
          "title": "Rotation Deg",
          "type": "number"
        },
        "position_x": {
          "default": 0,
          "maximum": 2,
          "minimum": -2,
          "title": "Position X",
          "type": "number"
        },
        "position_y": {
          "default": 0,
          "maximum": 2,
          "minimum": -2,
          "title": "Position Y",
          "type": "number"
        }
      },
      "title": "Transform",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "left_clip_id": {
          "title": "Left Clip Id",
          "type": "string"
        },
        "right_clip_id": {
          "title": "Right Clip Id",
          "type": "string"
        },
        "preset_id": {
          "default": "dissolve",
          "enum": [
            "dissolve",
            "slide_left",
            "slide_right",
            "slide_up",
            "slide_down",
            "wipe_left",
            "wipe_right",
            "wipe_up",
            "wipe_down",
            "fade_black",
            "fade_white",
            "iris_open",
            "flip_left",
            "flip_right",
            "flip_up",
            "flip_down",
            "cube_left",
            "cube_right",
            "cube_up",
            "cube_down",
            "clock_wipe",
            "push_cut",
            "cross_zoom",
            "blur_slide_left",
            "blur_slide_right",
            "blur_slide_up",
            "blur_slide_down",
            "film_burn",
            "glitch"
          ],
          "title": "Preset Id",
          "type": "string"
        },
        "preset_version": {
          "const": 1,
          "default": 1,
          "title": "Preset Version",
          "type": "integer"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        }
      },
      "required": [
        "left_clip_id",
        "right_clip_id",
        "duration_frames"
      ],
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "removed_asset_ids": {
      "items": {
        "type": "string"
      },
      "title": "Removed Asset Ids",
      "type": "array"
    },
    "composition": {
      "$ref": "#/$defs/Composition"
    },
    "clips": {
      "items": {
        "$ref": "#/$defs/Clip"
      },
      "title": "Clips",
      "type": "array"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "title": "Transitions",
      "type": "array"
    },
    "text_items": {
      "items": {
        "$ref": "#/$defs/TextItem"
      },
      "title": "Text Items",
      "type": "array"
    },
    "audio_items": {
      "items": {
        "$ref": "#/$defs/AudioItem"
      },
      "title": "Audio Items",
      "type": "array"
    },
    "cover": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cover"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "Snapshot",
  "type": "object"
}
